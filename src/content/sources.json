    {
      "id": "solar_tau_attenuation",
      "value": "0.328",
      "unit": "1/tau",
      "source": {
        "text": "The Planetary Society",
        "url": "https://www.planetary.org/articles/06-mer-update-opportunity-dust-storm-sleep"
      },
      "status": "verified",
      "note": "Fit of sunlight = exp(-k (tau - 0.5)) to Opportunity: 645 Wh at about tau 0.5 and 22 Wh at tau 10.8 give k = ln(645/22)/(10.8 - 0.5) = 0.328. A rough fit: it ignores panel dust, season and diffuse light details."
    },
