---
// One file for every inner page: /game/, /ai/, /science/, /evidence/, /classroom/, /team/, /credits/.
import PageInner from '../components/PageInner.astro';
import { pageIds, type PageId } from '../content';

export function getStaticPaths() {
  return pageIds.map((page) => ({ params: { page } }));
}
const page = Astro.params.page as PageId;
---

<PageInner page={page} />
