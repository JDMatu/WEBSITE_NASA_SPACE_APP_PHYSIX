---
// One file for every inner page: /science/, /about/, /credits/.
import PageInner from '../components/PageInner.astro';
import { innerPages, type PageId } from '../content';

export function getStaticPaths() {
  return innerPages.map((page) => ({ params: { page } }));
}
const page = Astro.params.page as PageId;
---

<PageInner page={page} />
