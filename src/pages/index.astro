---
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Storm from '../components/Storm.astro';
import Move from '../components/Move.astro';
import Watch from '../components/Watch.astro';
import Problem from '../components/Problem.astro';
import How from '../components/How.astro';
import Ranks from '../components/Ranks.astro';
import AiRule from '../components/AiRule.astro';
import Science from '../components/Science.astro';
import Evidence from '../components/Evidence.astro';
import Teachers from '../components/Teachers.astro';
import Team from '../components/Team.astro';
import Roadmap from '../components/Roadmap.astro';
import Closing from '../components/Closing.astro';
import Credits from '../components/Credits.astro';
import shareSrc from '../assets/frames/sol03-wide.webp';

const share = await getImage({ src: shareSrc, width: 1200, height: 630, format: 'jpg', quality: 80 });
---

<Base home shareImage={share.src}>
  <Storm />
  <Move />
  <Watch />
  <Problem />
  <How />
  <Ranks />
  <AiRule />
  <Science />
  <Evidence />
  <Teachers />
  <Team />
  <Roadmap />
  <Closing />
  <Credits />
</Base>
