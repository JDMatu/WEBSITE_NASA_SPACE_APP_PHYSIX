---
import Subpage from '../components/Subpage.astro';
import { facts, sourcesPage as c } from '../content/site';
import data from '../content/sources.json';
import { fill } from '../lib/util';

// The headline counts in the content file must match the synced source list.
for (const key of ['total', 'sourced', 'measured', 'derived', 'gameDesign', 'citations'] as const) {
  if (facts.constants[key] !== data.counts[key]) {
    throw new Error(`facts.constants.${key} is ${facts.constants[key]} in src/content/site.ts but ${data.counts[key]} in src/content/sources.json. Update site.ts.`);
  }
}
const evalValues = [facts.evalCurrentRules, facts.evalPreviousAi] as Record<string, string | number>[];
const testValues = { tests: facts.tests.passing, files: facts.tests.files, asOf: facts.tests.asOf };
type Row = { id: string; value: string; unit: string; source: { text: string; url: string | null } | null; note: string };
---

<Subpage title={c.title} intro={c.intro} back={c.back}>
  <ul class="plain" style="margin-top:28px">
    {c.kinds.map((k) => <li><strong>{k.name} ({k.name === 'Measured' ? data.counts.measured : k.name === 'Derived' ? data.counts.derived : data.counts.gameDesign}).</strong> {k.body}</li>)}
  </ul>
  <p class="note" style="margin-top:20px"><span>{c.caveat}</span></p>

  {
    ([[c.measuredTitle, data.measured], [c.derivedTitle, data.derived]] as [string, Row[]][]).map(([title, rows]) => (
      <>
        <h2>{title} ({rows.length})</h2>
        <div class="tablewrap">
          <table>
            <thead>
              <tr><th scope="col">Constant</th><th scope="col">Value</th><th scope="col">Unit</th><th scope="col">Source</th><th scope="col">Note</th></tr>
            </thead>
            <tbody>
              {
                rows.map((r) => (
                  <tr>
                    <th scope="row"><code>{r.id}</code></th>
                    <td class="num">{r.value}</td>
                    <td>{r.unit}</td>
                    <td>{r.source?.url ? <a href={r.source.url} rel="noopener">{r.source.text}</a> : r.source?.text}</td>
                    <td class="dim">{r.note}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </>
    ))
  }

  <h2>{c.designTitle} ({data.gameDesign.length})</h2>
  <p>{c.designIntro}</p>
  <details>
    <summary>{c.designToggle}</summary>
    <div class="tablewrap">
      <table>
        <thead>
          <tr><th scope="col">Constant</th><th scope="col">Value</th><th scope="col">Unit</th><th scope="col">Why</th></tr>
        </thead>
        <tbody>
          {data.gameDesign.map((r) => <tr><th scope="row"><code>{r.id}</code></th><td class="num">{r.value}</td><td>{r.unit}</td><td class="dim">{r.why}</td></tr>)}
        </tbody>
      </table>
    </div>
  </details>

  <h2>{c.eventsRealTitle} ({data.eventsReal.length})</h2>
  <div class="tablewrap">
    <table>
      <thead>
        <tr><th scope="col">Event</th><th scope="col">Affects</th><th scope="col">Effects in the game</th><th scope="col">Source</th></tr>
      </thead>
      <tbody>
        {data.eventsReal.map((e) => <tr><th scope="row">{e.name}</th><td>{e.affects.replace(/_/g, ' ')}</td><td class="num">{e.effects}</td><td>{e.source?.url ? <a href={e.source.url} rel="noopener">{e.source.text}</a> : ''}</td></tr>)}
      </tbody>
    </table>
  </div>

  <h2>{c.eventsTrainingTitle} ({data.eventsTraining.length})</h2>
  <p>{c.eventsTrainingIntro}</p>
  <ul class="plain" style="margin-top:12px">
    {data.eventsTraining.map((e) => <li>{e.name}</li>)}
  </ul>

  <h2>{c.citationsTitle} ({data.citations.length})</h2>
  <ul class="plain">
    {data.citations.map((x) => <li><a href={x.url} rel="noopener">{x.title}</a>. {x.organisation}, {x.year}.</li>)}
  </ul>

  <h2 id="evaluation">{c.evalTitle}</h2>
  <p>{c.evalIntro}</p>
  {
    c.evalRuns.map((run, i) => (
      <>
        <h3>{run.title}</h3>
        <p class="dim">{run.scope}</p>
        <div class="tablewrap">
          <table style="min-width:520px">
            <tbody>
              {run.rows.map(([k, v]) => <tr><th scope="row">{k}</th><td class="num">{fill(v!, evalValues[i]!)}</td></tr>)}
            </tbody>
          </table>
        </div>
      </>
    ))
  }
  <h3>{c.evalLimitsTitle}</h3>
  <ul class="plain">
    {c.evalLimits.map((l) => <li>{fill(l, testValues)}</li>)}
  </ul>
</Subpage>
