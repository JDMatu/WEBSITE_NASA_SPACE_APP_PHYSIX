---
import '../styles/global.css';
import { meta } from '../content/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { url } from '../lib/util';

interface Props {
  title?: string;
  description?: string;
  /** Absolute-path image for link previews (already built by astro:assets). */
  shareImage?: string;
  /** Sub-pages use a plain header that links back to the landing sections. */
  home?: boolean;
}
const { title = meta.title, description = meta.description, shareImage, home = false } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const share = shareImage && Astro.site ? new URL(shareImage, Astro.site).href : undefined;
---

<!doctype html>
<html lang={meta.lang} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0f1a" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {share && <meta property="og:image" content={share} />}
    <meta name="twitter:card" content={share ? 'summary_large_image' : 'summary'} />
    <slot name="head" />
    <script is:inline>
      // Progressive enhancement switches. Without JavaScript the page is the plain, complete version.
      (function () {
        var d = document.documentElement;
        d.classList.remove('no-js');
        d.classList.add('js');
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) d.classList.add('motion');
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header home={home} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      // Header background once the page is scrolled, and one-time reveals as sections enter.
      const head = document.querySelector('.site-head');
      const onScroll = () => head?.classList.toggle('is-stuck', window.scrollY > 24);
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });

      const targets = document.querySelectorAll('.reveal');
      if (document.documentElement.classList.contains('motion') && 'IntersectionObserver' in window) {
        document.documentElement.classList.add('rv');
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-in');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        targets.forEach((t) => io.observe(t));
      } else {
        targets.forEach((t) => t.classList.add('is-in'));
      }
    </script>
  </body>
</html>
