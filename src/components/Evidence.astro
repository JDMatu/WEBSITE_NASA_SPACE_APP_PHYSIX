---
import { copy, facts } from '../content';
import { fill, longDate, url } from '../lib/util';
import Icon from './Icon.astro';
import SectionHead from './SectionHead.astro';

const L = Astro.currentLocale;
const { evidence, ui } = copy(L);

const values: Record<string, Record<string, unknown>> = {
  current: { ...facts.evalCurrentRules, tests: facts.tests.passing, files: facts.tests.files, asOf: longDate(facts.tests.asOf, L) },
  previous: { ...facts.evalPreviousAi },
};
const missValues = facts.evalPreviousAi;
---

<section class="section section--tint evidence" id="evidence" aria-labelledby="evidence-title">
  <div class="wrap">
    <SectionHead kicker={evidence.kicker} title={evidence.title} lede={evidence.intro} id="evidence-title" />
    <div class="ev__groups">
      {
        evidence.groups.map((g) => (
          <section class:list={['ev__group', 'panel', 'panel--ticks', 'reveal', `ev__group--${g.id}`]} aria-label={g.label}>
            <header class="ev__ghead">
              <h3 class="h3">{g.label}</h3>
              <p>{g.scope}</p>
            </header>
            <ul class="ev__stats">
              {
                g.stats.map((s) => (
                  <li>
                    <p class="ev__value num">{fill(s.value, values[g.id]!, L)}</p>
                    <p class="ev__label">{s.label}</p>
                    <p class="ev__note">{fill(s.note, values[g.id]!, L)}</p>
                  </li>
                ))
              }
            </ul>
          </section>
        ))
      }
    </div>
    <div class="ev__honest">
      <div class="reveal">
        <h3 class="h3">{evidence.missesTitle}</h3>
        <ul class="ev__list">
          {evidence.misses.map((m) => <li>{fill(m, missValues, L)}</li>)}
        </ul>
      </div>
      <div class="reveal" style="--d:100ms">
        <h3 class="h3">{evidence.limitsTitle}</h3>
        <ul class="ev__list">
          {evidence.limits.map((m) => <li>{m}</li>)}
        </ul>
      </div>
    </div>
    <p class="ev__more"><a class="link-arrow" href={url('/sources/', L) + '#evaluation'}>{evidence.evalsLink}<Icon name="arrow" /></a></p>
  </div>
</section>

<style>
  .ev__groups { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  .ev__group { padding: clamp(20px, 3vw, 32px); }
  .ev__ghead { padding-bottom: 16px; margin-bottom: 4px; border-bottom: 1px solid var(--hair); }
  .ev__ghead p { margin-top: 6px; font-size: 14.5px; line-height: 1.45; color: var(--dim); min-height: 2.9em; }
  .ev__group--current .h3 { color: var(--good); }
  .ev__group--previous .h3 { color: var(--amber); }
  .ev__stats li { padding: 18px 0; border-bottom: 1px solid var(--hair); }
  .ev__stats li:last-child { border-bottom: 0; padding-bottom: 0; }
  .ev__value { font-size: clamp(34px, 4vw, 48px); line-height: 1; font-weight: 500; color: var(--simsup); letter-spacing: -0.02em; }
  .ev__label { margin-top: 8px; font-weight: 500; font-size: 17px; }
  .ev__note { margin-top: 2px; font-size: 14.5px; color: var(--dim); line-height: 1.45; }
  .ev__honest { margin-top: clamp(32px, 5vw, 56px); display: grid; grid-template-columns: 1fr 1fr; gap: 28px 48px; }
  .ev__list { margin-top: 12px; display: grid; gap: 10px; font-size: 15.5px; line-height: 1.5; }
  .ev__list li { padding-left: 18px; position: relative; max-width: 58ch; }
  .ev__list li::before { content: ''; position: absolute; left: 0; top: 0.62em; width: 8px; height: 1px; background: var(--amber); }
  .ev__more { margin-top: 32px; }
  @media (max-width: 900px) { .ev__groups, .ev__honest { grid-template-columns: 1fr; } .ev__ghead p { min-height: 0; } }
</style>
