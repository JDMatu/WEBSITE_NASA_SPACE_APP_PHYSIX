  down: '<path d="M12 4v15M6 13l6 6 6-6"/>',
  play: '<path d="M7 4.5v15l12-7.5z" fill="currentColor" stroke="none"/>',
  check: '<path d="M4.5 12.5l5 5 10-11"/>',
  next: '<circle cx="12" cy="12" r="8"/><path d="M12 8v4l2.5 2.5"/>',
  info: '<circle cx="12" cy="12" r="9"/><path d="M12 11v6M12 7.5v.5"/>',
  x: '<path d="M6 6l12 12M18 6L6 18"/>',
  life: '<path d="M12 3.5c3.2 3.8 5.5 6.8 5.5 9.8a5.5 5.5 0 0 1-11 0c0-3 2.3-6 5.5-9.8z"/><path d="M9.5 14.5a2.6 2.6 0 0 0 2.5 2"/>',
  power: '<path d="M13 2.5L5.5 13.5H11l-1 8 7.5-11H12z"/>',
