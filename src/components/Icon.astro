  food: '<path d="M12 21v-9"/><path d="M12 12c0-4 2.500-7 7.500-7.500 0 5-2.500 8-7.500 7.500z"/><path d="M12 15c0-3-2-5-6.500-5.500 0 4 2 6 6.500 5.500z"/>',
  screen: '<rect x="3" y="4.5" width="18" height="12" rx="1"/><path d="M8.500 20.500h7M12 16.500v4"/>',
  lock: '<rect x="5" y="10.500" width="14" height="9.500" rx="1"/><path d="M8 10.500V7.500a4 4 0 0 1 8 0v3"/>',
  wifi: '<path d="M3 9.500a13.500 13.500 0 0 1 18 0M6.500 13.200a8.500 8.500 0 0 1 11 0M9.800 16.800a3.500 3.500 0 0 1 4.400 0"/><path d="M12 20v.010"/>',
