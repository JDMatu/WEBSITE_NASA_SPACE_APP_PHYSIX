---
// Bottom of an inner page: the previous and the next page of the menu.
import { copy, menu, type PageId } from '../content';
import { url } from '../lib/util';
import Icon from './Icon.astro';

interface Props {
  page: PageId;
}
const { page } = Astro.props;
const L = Astro.currentLocale;
const { pages, ui } = copy(L);
const i = menu.indexOf(page);
const next = i >= 0 ? menu[(i + 1) % menu.length]! : menu[0]!;
---

<nav class="nextpage" aria-label={ui.next}>
  <a class="wrap nextpage__in" href={url(`/${next}/`, L)}>
    <span class="nextpage__k">{ui.next}</span>
    <span class="nextpage__title">{pages[next].nav}</span>
    <span class="nextpage__text">{pages[next].teaser}</span>
    <span class="nextpage__arrow"><Icon name="arrow" /></span>
  </a>
</nav>

<style>
  .nextpage { border-top: 1px solid var(--hair); background: var(--ink-2); }
  .nextpage__in { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: 4px 32px; align-items: center; padding-block: clamp(28px, 4vw, 44px); text-decoration: none; color: var(--text); }
  .nextpage__k { grid-column: 1 / -1; font-family: var(--font-head); font-weight: 600; font-size: 14px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--amber); }
  .nextpage__title { font-family: var(--font-head); font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; font-size: clamp(30px, 4vw, 48px); line-height: 1.05; white-space: nowrap; }
  .nextpage__text { font-size: 15.5px; line-height: 1.5; color: var(--dim); max-width: 60ch; }
  .nextpage__arrow { width: 52px; height: 52px; border: 1px solid var(--hair-strong); display: flex; align-items: center; justify-content: center; transition: border-color 0.18s var(--ease), background 0.18s var(--ease); }
  .nextpage__arrow :global(svg) { width: 22px; height: 22px; transition: transform 0.18s var(--ease); }
  .nextpage__in:hover .nextpage__arrow { border-color: var(--amber); background: rgba(246, 196, 69, 0.08); }
  .nextpage__in:hover .nextpage__arrow :global(svg) { transform: translateX(3px); }
  @media (max-width: 760px) {
    .nextpage__in { grid-template-columns: minmax(0, 1fr) auto; }
    .nextpage__title { white-space: normal; }
    .nextpage__text { grid-column: 1 / -1; grid-row: 3; }
  }
</style>
