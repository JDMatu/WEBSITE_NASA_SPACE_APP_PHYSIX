---
// The inner pages of the site, shared by every language. Each page is a few sections; the first
// one carries the page title. To move a section to another page, move its line here.
import Base from '../layouts/Base.astro';
import { copy, type PageId } from '../content';
import AiRule from './AiRule.astro';
import Closing from './Closing.astro';
import Credits from './Credits.astro';
import Evidence from './Evidence.astro';
import How from './How.astro';
import NextPage from './NextPage.astro';
import Problem from './Problem.astro';
import Ranks from './Ranks.astro';
import Roadmap from './Roadmap.astro';
import Science from './Science.astro';
import Teachers from './Teachers.astro';
import Team from './Team.astro';

interface Props {
  page: PageId;
}
const { page } = Astro.props;
const { meta, pages } = copy(Astro.currentLocale);
---

<Base title={`${pages[page].title} · ${meta.name}`} description={pages[page].description}>
  {
    page === 'game' && (
      <>
        <Problem lead />
        <How />
        <Ranks />
      </>
    )
  }
  {page === 'ai' && <AiRule lead />}
  {page === 'science' && <Science lead />}
  {
    page === 'evidence' && (
      <>
        <Evidence lead />
        <Roadmap />
      </>
    )
  }
  {page === 'classroom' && <Teachers lead />}
  {page === 'team' && <Team lead />}
  {page === 'credits' && <Credits lead />}
  <NextPage page={page} />
  <Closing />
</Base>
