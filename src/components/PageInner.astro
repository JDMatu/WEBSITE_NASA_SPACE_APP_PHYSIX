---
// The inner pages of the site, shared by every language.
import Base from '../layouts/Base.astro';
import { copy, type PageId } from '../content';
import About from './About.astro';
import Closing from './Closing.astro';
import Credits from './Credits.astro';
import SciencePage from './SciencePage.astro';

interface Props {
  page: PageId;
}
const { page } = Astro.props;
const { meta, pages } = copy(Astro.currentLocale);
---

<Base title={`${pages[page].title} · ${meta.name}`} description={pages[page].description}>
  {page === 'science' && <SciencePage />}
  {page === 'about' && <About />}
  {page === 'credits' && <Credits lead />}
  <Closing />
</Base>
