---
// The "Science & AI" page: one heading, an in-page menu that stays in view, then four sections:
// the AI rule, the science, the evidence, and the honest status.
import { copy } from '../content';
import AiRule from './AiRule.astro';
import Evidence from './Evidence.astro';
import Roadmap from './Roadmap.astro';
import Science from './Science.astro';

const { sciencePage: c } = copy(Astro.currentLocale);
---

<section class="section section--lead scihead" aria-labelledby="sci-title">
  <div class="wrap">
    <header class="head reveal">
      <p class="kicker">{c.kicker}</p>
      <h1 class="h2 h2--wide" id="sci-title">{c.title}</h1>
      <p class="lede">{c.lede}</p>
    </header>
    <ol class="scitoc">
      {
        c.toc.map((t, i) => (
          <li class="reveal" style={`--d:${i * 60}ms`}>
            <a href={t.href}>
              <span class="num">{String(i + 1).padStart(2, '0')}</span>
              <b>{t.label}</b>
              <span class="scitoc__text">{t.text}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<nav class="subnav" aria-label={c.tocLabel} data-subnav>
  <div class="wrap subnav__in">
    {c.toc.map((t, i) => <a href={t.href}><span class="num">{String(i + 1).padStart(2, '0')}</span>{t.label}</a>)}
  </div>
</nav>

<AiRule />
<Science />
<Evidence />
<Roadmap />

<style>
  .scihead { padding-bottom: clamp(36px, 5vw, 64px); }
  .scihead .head { margin-bottom: clamp(28px, 4vw, 44px); }
  .scitoc { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; }
  .scitoc a { display: grid; gap: 4px; align-content: start; height: 100%; padding: 16px 18px 18px; text-decoration: none; background: rgba(17, 23, 39, 0.72); border: 1px solid var(--hair); border-top: 2px solid var(--amber); transition: background 0.2s var(--ease), border-color 0.2s var(--ease); }
  .scitoc a:hover { background: rgba(246, 196, 69, 0.06); border-color: var(--amber); }
  .scitoc .num { font-size: 12.5px; color: var(--amber); letter-spacing: 0.08em; }
  .scitoc b { font-family: var(--font-head); font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; font-size: clamp(21px, 2vw, 26px); line-height: 1.1; }
  .scitoc__text { font-size: 15px; line-height: 1.45; color: var(--dim); }

  /* The in-page menu follows the reader under the header. */
  .subnav { position: sticky; top: var(--head-h); z-index: 20; background: rgba(11, 15, 26, 0.94); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border-block: 1px solid var(--hair); }
  .subnav__in { display: flex; gap: clamp(16px, 3vw, 40px); overflow-x: auto; scrollbar-width: none; }
  .subnav__in::-webkit-scrollbar { display: none; }
  .subnav a { position: relative; display: inline-flex; align-items: baseline; gap: 8px; padding: 13px 0 12px; white-space: nowrap; text-decoration: none; font-family: var(--font-head); font-weight: 600; font-size: 15px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--dim); }
  .subnav a .num { font-size: 11.5px; color: var(--hair-strong); letter-spacing: 0.04em; }
  .subnav a:hover, .subnav a.is-on { color: var(--text); }
  .subnav a.is-on .num { color: var(--amber); }
  .subnav a.is-on::after { content: ''; position: absolute; left: 0; right: 0; bottom: -1px; height: 2px; background: var(--amber); }
  @media (max-width: 1000px) { .scitoc { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 480px) { .scitoc { grid-template-columns: 1fr; } }
</style>

<script>
  // Marks the section being read in the in-page menu. Without this the links still work.
  const nav = document.querySelector<HTMLElement>('[data-subnav]');
  if (nav && 'IntersectionObserver' in window) {
    const links = [...nav.querySelectorAll<HTMLAnchorElement>('a')];
    const targets = links.map((a) => document.querySelector<HTMLElement>(a.getAttribute('href') ?? '')).filter((t): t is HTMLElement => Boolean(t));
    const mark = () => {
      const line = window.innerHeight * 0.35;
      let on = -1;
      targets.forEach((t, k) => {
        if (t.getBoundingClientRect().top <= line) on = k;
      });
      links.forEach((a, k) => a.classList.toggle('is-on', k === on));
    };
    let ticking = false;
    window.addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          ticking = false;
          mark();
        });
      },
      { passive: true },
    );
    mark();
  }
</script>
