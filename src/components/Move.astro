---
import { move } from '../content/site';
import Icon from './Icon.astro';
import SectionHead from './SectionHead.astro';
import Shot from './Shot.astro';
---

<section class="section move" id="move" aria-labelledby="move-title">
  <div class="wrap">
    <SectionHead kicker={move.kicker} title={move.title} lede={move.body} wide id="move-title" />
    <ul class="systems">
      {
        move.systems.map((s, i) => (
          <li class={`system system--${s.id} reveal`} style={`--d:${i * 70}ms`}>
            <span class="system__icon"><Icon name={s.id as 'life' | 'power' | 'rad' | 'food'} /></span>
            <h3 class="h3">{s.name}</h3>
            <p>{s.body}</p>
          </li>
        ))
      }
    </ul>
    <figure class="move__fig reveal">
      <div class="shot"><Shot name="move-plan" alt={move.shotAlt} sizes="(max-width: 1240px) 92vw, 1180px" widths={[480, 800, 1200, 1440, 2000]} /></div>
      <figcaption class="figcap">{move.shotCaption}</figcaption>
    </figure>
  </div>
</section>

<style>
  .systems { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .system { padding: 22px 20px 24px; background: rgba(17, 23, 39, 0.72); border: 1px solid var(--hair); border-top: 2px solid var(--c); }
  .system--life { --c: var(--c-life); }
  .system--power { --c: var(--c-power); }
  .system--rad { --c: var(--c-rad); }
  .system--food { --c: var(--c-food); }
  .system__icon { display: inline-flex; width: 40px; height: 40px; align-items: center; justify-content: center; color: var(--c); border: 1px solid color-mix(in srgb, var(--c) 45%, transparent); margin-bottom: 14px; }
  .system__icon :global(svg) { width: 22px; height: 22px; }
  .system p { margin-top: 8px; font-size: 15.5px; line-height: 1.5; color: var(--dim); }
  .move__fig { margin-top: clamp(32px, 5vw, 56px); }
  @media (max-width: 980px) { .systems { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 520px) { .systems { grid-template-columns: 1fr; } }
</style>
