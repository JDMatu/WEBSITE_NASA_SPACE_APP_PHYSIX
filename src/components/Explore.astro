---
// Home page: one card per page of the site, each with a figure taken from the facts.
import { copy, facts, menu } from '../content';
import { fill, url } from '../lib/util';
import Icon from './Icon.astro';
import SectionHead from './SectionHead.astro';

const L = Astro.currentLocale;
const { explore, pages } = copy(L);
const values = { actionCount: facts.actionCount, sourced: facts.constants.sourced, tests: facts.tests.passing };
---

<section class="section section--tint explore" id="explore" aria-labelledby="explore-title">
  <div class="wrap">
    <SectionHead kicker={explore.kicker} title={explore.title} lede={explore.body} wide id="explore-title" />
    <ul class="doors">
      {
        menu.map((id, i) => (
          <li class="reveal" style={`--d:${(i % 3) * 70}ms`}>
            <a class="door" href={url(`/${id}/`, L)}>
              <span class="door__n num">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="door__title">{pages[id].nav}</h3>
              <p class="door__text">{pages[id].teaser}</p>
              <p class="door__stat">
                <b class="num">{fill(pages[id].stat, values, L)}</b>
                <span>{pages[id].statLabel}</span>
              </p>
              <span class="door__go">{explore.open}<Icon name="arrow" /></span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .doors { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .doors li { display: flex; }
  .door {
    position: relative; flex: 1; display: flex; flex-direction: column; padding: 22px 24px 20px; text-decoration: none; color: var(--text);
    background: rgba(17, 23, 39, 0.72); border: 1px solid var(--hair); transition: border-color 0.2s var(--ease), background 0.2s var(--ease), transform 0.2s var(--ease);
  }
  .door:hover { border-color: var(--amber); background: rgba(246, 196, 69, 0.05); }
  :global(html.motion) .door:hover { transform: translateY(-3px); }
  .door__n { font-size: 13px; color: var(--amber); letter-spacing: 0.08em; }
  .door__title { margin-top: 6px; font-family: var(--font-head); font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; font-size: clamp(26px, 2.5vw, 34px); line-height: 1.05; }
  .door__text { margin-top: 10px; font-size: 15.5px; line-height: 1.5; color: var(--dim); }
  .door__stat { margin-top: auto; padding-top: 20px; display: flex; align-items: baseline; gap: 12px; }
  .door__stat b { font-size: clamp(34px, 3.4vw, 46px); font-weight: 500; line-height: 1; color: var(--simsup); letter-spacing: -0.02em; }
  .door__stat span { font-size: 14px; line-height: 1.35; color: var(--dim); max-width: 22ch; }
  .door__go { margin-top: 18px; padding-top: 14px; border-top: 1px solid var(--hair); display: flex; align-items: center; justify-content: space-between; font-family: var(--font-head); font-weight: 600; font-size: 15px; letter-spacing: 0.14em; text-transform: uppercase; }
  .door__go :global(svg) { width: 18px; height: 18px; color: var(--amber); transition: transform 0.18s var(--ease); }
  .door:hover .door__go :global(svg) { transform: translateX(4px); }
  @media (max-width: 1000px) { .doors { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 620px) { .doors { grid-template-columns: 1fr; } }
</style>
