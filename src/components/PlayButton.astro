---
import { copy, pending } from '../content';
import Icon from './Icon.astro';

const L = Astro.currentLocale;
const { play, ui } = copy(L);

interface Props {
  size?: 'sm' | 'lg';
  /** Show the one-line note under the button (hosting mode, or why it is not live yet). */
  note?: boolean;
}
const { size = 'lg', note = false } = Astro.props;
const live = Boolean(pending.playUrl);
const noteText = live ? (pending.playMode === 'ai' ? play.noteAi : play.noteRules) : play.pendingNote;
---

<span class:list={['play', `play--${size}`]}>
  {
    live ? (
      <a class:list={['btn', 'btn-primary', size === 'sm' && 'btn-sm']} href={pending.playUrl} data-play>
        <Icon name="play" />
        {play.label}
      </a>
    ) : (
      <span class:list={['btn', 'btn-pending', size === 'sm' && 'btn-sm']} data-pending="playUrl">
        {size === 'sm' ? ui.playSoonShort : play.pendingLabel}
      </span>
    )
  }
  {note && <span class="play__note">{noteText}</span>}
</span>

<style>
  .play { display: inline-flex; flex-direction: column; gap: 8px; align-items: flex-start; }
  .play__note { font-size: 13.500px; line-height: 1.4; color: var(--dim); max-width: 38ch; }
</style>
