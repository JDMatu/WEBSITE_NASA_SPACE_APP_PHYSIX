---
import { copy, pending } from '../content';
import { url } from '../lib/util';
import Icon from './Icon.astro';

const L = Astro.currentLocale;
const { ranks, teachers, ui } = copy(L);

const icons = ['screen', 'lock', 'wifi', 'lang'] as const;
interface Props {
  /** First section of its page: the title becomes the page's h1. */
  lead?: boolean;
}
const { lead = false } = Astro.props;
const H = lead ? 'h1' : 'h2';
---

<section class:list={['section', 'teachers', lead && 'section--lead']} id="teachers" aria-labelledby="teachers-title">
  <div class="wrap teachers__grid">
    <div class="reveal">
      <p class="kicker">{teachers.kicker}</p>
      <H class="h2" id="teachers-title">{teachers.title}</H>
      <p class="lede teachers__lede">{teachers.body}</p>
      <p class="note teachers__note"><Icon name="info" /><span>{teachers.notice}</span></p>
      <p class="teachers__contact">
        {
          pending.contactEmail ? (
            <a class="link-arrow" href={`mailto:${pending.contactEmail}`}>{teachers.contactLabel}: {pending.contactEmail}<Icon name="arrow" /></a>
          ) : (
            <span class="pending-mark" data-pending="contactEmail">{teachers.contactPending}</span>
          )
        }
      </p>
    </div>
    <ul class="teachers__points">
      {
        teachers.points.map((p, i) => (
          <li class="reveal" style={`--d:${i * 70}ms`}>
            <span class="teachers__icon"><Icon name={icons[i]!} /></span>
            <div>
              <h3>{p.title}</h3>
              <p>{p.body}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
  <div class="wrap classranks">
    <header class="reveal">
      <h2 class="h3 classranks__title">{teachers.ranksTitle}</h2>
      <p>{teachers.ranksIntro}</p>
    </header>
    <ol class="classranks__list">
      {
        ranks.items.map((r, i) => (
          <li class="reveal" style={`--d:${i * 70}ms`}>
            <span class="segbar classranks__lvl" aria-hidden="true">
              {[0, 1, 2, 3].map((k) => <i class={k <= i ? 'on' : ''} />)}
            </span>
            <h3 class="h3">{r.name}</h3>
            <p>{r.body}</p>
          </li>
        ))
      }
    </ol>
    <p class="classranks__foot">{teachers.practice}</p>
    <p class="more-links"><a class="link-arrow" href={url('/game/', L) + '#ranks'}>{teachers.ranksLink}<Icon name="arrow" /></a></p>
  </div>
</section>

<style>
  .teachers__grid { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 6fr); gap: clamp(28px, 5vw, 72px); align-items: start; }
  .teachers__lede { margin-top: 20px; }
  .teachers__note { margin-top: 24px; max-width: 520px; }
  .teachers__contact { margin-top: 20px; }
  .teachers__points { display: grid; gap: 0; border-top: 1px solid var(--hair); }
  .teachers__points li { display: grid; grid-template-columns: 44px 1fr; gap: 16px; padding: 20px 0; border-bottom: 1px solid var(--hair); }
  .teachers__icon { width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; border: 1px solid var(--hair-strong); color: var(--simsup); }
  .teachers__icon :global(svg) { width: 22px; height: 22px; }
  .teachers__points h3 { font-size: 18px; font-weight: 600; line-height: 1.3; }
  .teachers__points p { margin-top: 4px; font-size: 15.5px; color: var(--dim); line-height: 1.5; }
  .classranks { margin-top: clamp(56px, 8vw, 96px); padding-top: clamp(32px, 5vw, 48px); border-top: 1px solid var(--hair); }
  .classranks__title { font-size: clamp(26px, 3vw, 34px); letter-spacing: 0.06em; }
  .classranks header p { margin-top: 10px; max-width: 60ch; color: var(--dim); }
  .classranks__list { margin-top: 28px; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
  .classranks__list li { padding: 20px; background: rgba(17, 23, 39, 0.72); border: 1px solid var(--hair); }
  .classranks__lvl { width: 84px; --accent: var(--amber); margin-bottom: 14px; }
  .classranks__list .h3 { font-size: 24px; letter-spacing: 0.08em; }
  .classranks__list p { margin-top: 8px; font-size: 15px; line-height: 1.5; color: var(--dim); }
  .classranks__foot { margin-top: 22px; padding-left: 16px; border-left: 2px solid var(--hair-strong); max-width: 64ch; font-size: 16px; }
  @media (max-width: 1000px) { .classranks__list { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 520px) { .classranks__list { grid-template-columns: 1fr; } }
  @media (max-width: 900px) { .teachers__grid { grid-template-columns: 1fr; } }
</style>
