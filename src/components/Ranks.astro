---
import { facts, ranks } from '../content/site';
import SectionHead from './SectionHead.astro';
import Shot from './Shot.astro';

const win = facts.evalCurrentRules.winRateByRank;
---

<section class="section ranks" id="ranks" aria-labelledby="ranks-title">
  <div class="wrap">
    <SectionHead kicker={ranks.kicker} title={ranks.title} lede={ranks.intro} wide id="ranks-title" />
    <ol class="ladder">
      {
        ranks.items.map((r, i) => (
          <li class="rank reveal" style={`--d:${i * 80}ms`}>
            <div class="rank__top">
              <span class="segbar rank__lvl" aria-hidden="true">
                {[0, 1, 2, 3].map((k) => <i class={k <= i ? 'on' : ''} />)}
              </span>
              <h3 class="h3">{r.name}</h3>
              <p>{r.body}</p>
            </div>
            <div class="shot rank__shot"><Shot name={r.shot} alt={r.alt} sizes="(max-width: 700px) 78vw, (max-width: 1100px) 44vw, 270px" widths={[280, 400, 560, 800]} /></div>
          </li>
        ))
      }
    </ol>

    <figure class="winchart panel panel--ticks reveal" aria-labelledby="win-title">
      <h3 class="h3" id="win-title">{ranks.chartTitle}</h3>
      <ul class="winchart__bars">
        {
          win.map((w) => (
            <li>
              <span class="winchart__label">{w.rank}</span>
              <span class="winchart__track"><i style={`--v:${w.pct / 100}`} /></span>
              <span class="winchart__val num">{w.pct} %</span>
            </li>
          ))
        }
      </ul>
      <figcaption class="figcap">{ranks.chartNote}</figcaption>
    </figure>
  </div>
</section>

<style>
  .ladder { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
  .rank { display: flex; flex-direction: column; background: rgba(17, 23, 39, 0.72); border: 1px solid var(--hair); }
  .rank__top { padding: 20px 20px 18px; }
  .rank__lvl { width: 84px; --accent: var(--amber); margin-bottom: 14px; }
  .rank__top .h3 { font-size: 26px; letter-spacing: 0.08em; }
  .rank__top p { margin-top: 8px; font-size: 15px; line-height: 1.5; color: var(--dim); min-height: 6em; }
  .rank__shot { margin-top: auto; border-width: 1px 0 0; }
  .winchart { margin-top: clamp(32px, 5vw, 56px); padding: 24px clamp(18px, 3vw, 32px); max-width: 760px; }
  .winchart__bars { margin-top: 16px; display: grid; gap: 10px; }
  .winchart__bars li { display: grid; grid-template-columns: 110px 1fr 56px; gap: 12px; align-items: center; }
  .winchart__label { font-family: var(--font-head); font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; font-size: 15px; }
  .winchart__track { height: 12px; background: rgba(255, 255, 255, 0.08); position: relative; display: block; }
  .winchart__track i { position: absolute; inset: 0; background: var(--simsup); transform-origin: left; transform: scaleX(var(--v)); display: block; }
  :global(html.rv) .winchart.reveal .winchart__track i { transform: scaleX(0); transition: transform 0.9s var(--ease) 0.2s; }
  :global(html.rv) .winchart.reveal.is-in .winchart__track i { transform: scaleX(var(--v)); }
  .winchart__val { text-align: right; font-size: 15px; }
  @media (max-width: 1100px) {
    .ladder { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .rank__top p { min-height: 0; }
  }
  @media (max-width: 700px) {
    .ladder { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; margin-inline: calc(-1 * var(--pad)); padding-inline: var(--pad); padding-bottom: 12px; scrollbar-width: thin; scrollbar-color: rgba(255, 255, 255, 0.25) transparent; }
    .rank { flex: 0 0 78%; scroll-snap-align: center; }
    .winchart__bars li { grid-template-columns: 92px 1fr 48px; gap: 8px; }
  }
</style>
