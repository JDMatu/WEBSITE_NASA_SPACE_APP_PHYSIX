---
// Shared frame for the text sub-pages.
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import { copy } from '../content';
import { url } from '../lib/util';

const L = Astro.currentLocale;
const { meta, ui } = copy(L);

interface Props {
  title: string;
  intro: string;
  back: string;
}
const { title, intro, back } = Astro.props;
---

<Base title={`${title} · ${meta.name}`} description={intro}>
  <article class="sub">
    <div class="wrap sub__in">
      <p class="sub__back"><a class="link-arrow link-arrow--back" href={url('/', L)}><Icon name="arrow" />{back}</a></p>
      <h1 class="h2 h2--wide">{title}</h1>
      <p class="lede">{intro}</p>
      <slot />
      <p class="sub__back sub__back--end"><a class="link-arrow link-arrow--back" href={url('/', L)}><Icon name="arrow" />{back}</a></p>
    </div>
  </article>
</Base>

<style is:global>
  .sub { padding-block: calc(var(--head-h) + 48px) 96px; }
  .sub .lede { margin-top: 18px; }
  .sub__back { margin-bottom: 28px; font-size: 15px; }
  .sub__back--end { margin: 56px 0 0; }
  .link-arrow--back svg { transform: rotate(180deg); }
  .link-arrow--back:hover svg { transform: rotate(180deg) translateX(3px); }
  .sub h2 { font-family: var(--font-head); font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; font-size: clamp(24px, 3vw, 32px); line-height: 1.1; margin: 56px 0 14px; padding-top: 22px; border-top: 1px solid var(--hair); scroll-margin-top: calc(var(--head-h) + 12px); }
  .sub h3 { font-size: 18px; font-weight: 600; margin: 26px 0 6px; }
  .sub p { max-width: 74ch; }
  .sub p + p { margin-top: 12px; }
  .sub ul.plain { display: grid; gap: 8px; max-width: 74ch; }
  .sub ul.plain li { padding-left: 18px; position: relative; }
  .sub ul.plain li::before { content: ''; position: absolute; left: 0; top: 0.7em; width: 8px; height: 1px; background: var(--amber); }
  .sub .tablewrap { margin-top: 14px; overflow-x: auto; border: 1px solid var(--hair); }
  .sub table { width: 100%; border-collapse: collapse; font-size: 14.5px; line-height: 1.45; min-width: 860px; }
  .sub th, .sub td { text-align: left; padding: 10px 14px; border-bottom: 1px solid var(--hair); vertical-align: top; }
  .sub thead th { font-family: var(--font-head); font-weight: 600; font-size: 13px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--dim); background: rgba(255, 255, 255, 0.03); white-space: nowrap; }
  .sub tbody tr:last-child > * { border-bottom: 0; }
  .sub tbody th { font-weight: 500; }
  .sub td.num, .sub code { font-family: var(--font-mono); font-size: 13.5px; }
  .sub code { color: var(--simsup); white-space: nowrap; }
  .sub td.dim { color: var(--dim); }
  .sub details { margin-top: 14px; }
  .sub summary { cursor: pointer; padding: 12px 16px; border: 1px solid var(--hair-strong); font-family: var(--font-head); font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; font-size: 15px; width: fit-content; }
  .sub summary:hover { border-color: var(--amber); }
</style>
