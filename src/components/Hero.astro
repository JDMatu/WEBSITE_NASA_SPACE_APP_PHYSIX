---
// The first screen of the home page: what PHYSIX is, the play button, and the base on a clear sol.
import { copy, pending } from '../content';
import { url } from '../lib/util';
import Frame from './Frame.astro';
import Icon from './Icon.astro';
import PlayButton from './PlayButton.astro';

const L = Astro.currentLocale;
const { hero } = copy(L);
const hasVideo = Boolean(pending.videoExtendedUrl);
---

<section class="hero" id="top">
  <div class="hero__bg"><Frame id="sol01" alt={hero.imageAlt} eager /></div>
  <div class="wrap hero__in">
    <div class="hero__copy">
      <p class="hero__eyebrow">{hero.eyebrow}</p>
      <h1 class="hero__title">
        {
          hero.title.map((line) => (
            <span>
              {line.split(' ').map((word, k) => (
                <>
                  {k > 0 && ' '}
                  {word.includes('-') ? <span class="nw">{word}</span> : word}
                </>
              ))}
            </span>
          ))
        }
      </h1>
      <p class="hero__body hero__body--long">{hero.body}</p>
      <p class="hero__body hero__body--short">{hero.bodyShort}</p>
      <div class="hero__cta">
        <PlayButton />
        <a class="btn btn-ghost" href={hasVideo ? '#watch' : url('/game/', L)}>
          {hasVideo && <Icon name="play" />}
          {hasVideo ? hero.watchLabel : hero.watchPendingLabel}
        </a>
      </div>
      <ul class="hero__small">
        {hero.small.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </div>
  <a class="hero__cue" href="#storm">
    <span>{hero.scrollCue}</span>
    <Icon name="down" />
  </a>
</section>

<style is:global>
  .frame img { width: 100%; height: 100%; object-fit: cover; }
  .hero { position: relative; min-height: 100vh; min-height: 100svh; display: flex; align-items: center; isolation: isolate; padding-block: calc(var(--head-h) + 24px) 88px; }
  .hero__bg { position: absolute; inset: 0; z-index: -2; }
  .hero__bg .frame { position: absolute; inset: 0; }
  .hero::before {
    content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background:
      linear-gradient(90deg, rgba(11, 15, 26, 0.9) 0, rgba(11, 15, 26, 0.72) 28%, rgba(11, 15, 26, 0.18) 52%, rgba(11, 15, 26, 0) 70%),
      linear-gradient(180deg, rgba(11, 15, 26, 0.55) 0, rgba(11, 15, 26, 0) 22%, rgba(11, 15, 26, 0) 70%, var(--ink) 100%);
  }
  .hero__copy { max-width: 590px; }
  .hero__title, .hero__body { max-width: 540px; }
  .hero__eyebrow {
    display: inline-flex; align-items: center; gap: 12px; margin-bottom: 18px;
    font-family: var(--font-head); font-weight: 600; font-size: 15px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--amber);
  }
  .hero__eyebrow::before { content: ''; width: 28px; height: 1px; background: currentColor; }
  .hero__title {
    font-family: var(--font-head); font-weight: 700; text-transform: uppercase; letter-spacing: 0.03em;
    font-size: clamp(40px, 4.7vw, 72px); line-height: 0.98; text-shadow: 0 2px 18px rgba(11, 15, 26, 0.55);
  }
  .hero__title > span { display: block; text-wrap: balance; }
  .hero__title .nw { white-space: nowrap; }
  .hero__title > span + span { color: var(--simsup); }
  .hero__body { margin-top: 22px; font-size: clamp(16.5px, 1.35vw, 19px); line-height: 1.55; max-width: 52ch; text-shadow: 0 1px 12px rgba(11, 15, 26, 0.6); }
  .hero__body--short { display: none; }
  .hero__cta { margin-top: 28px; display: flex; flex-wrap: wrap; gap: 12px; align-items: flex-start; }
  .hero__small { margin-top: 20px; display: flex; flex-wrap: wrap; gap: 6px 0; font-family: var(--font-mono); font-size: 13px; color: var(--dim); letter-spacing: 0.02em; }
  .hero__small li + li::before { content: '·'; margin: 0 10px; color: var(--hair-strong); }
  .hero__cue {
    position: absolute; left: 50%; bottom: 22px; transform: translateX(-50%); display: inline-flex; align-items: center; gap: 10px;
    font-family: var(--font-head); font-weight: 600; font-size: 14px; letter-spacing: 0.16em; text-transform: uppercase; text-decoration: none; color: var(--text);
    padding: 8px 14px; white-space: nowrap;
  }
  .hero__cue svg { width: 16px; height: 16px; color: var(--amber); }
  html.motion .hero__cue svg { animation: cue 1.8s var(--ease) infinite; }
  @keyframes cue { 0%, 100% { transform: translateY(-2px); } 50% { transform: translateY(4px); } }

  @media (max-aspect-ratio: 4/5) {
    .hero { align-items: flex-end; padding-bottom: 64px; }
    .hero::before {
      background: linear-gradient(180deg, rgba(11, 15, 26, 0.6) 0, rgba(11, 15, 26, 0) 14%, rgba(11, 15, 26, 0) 36%, rgba(11, 15, 26, 0.8) 52%, rgba(11, 15, 26, 0.96) 72%);
    }
    .hero__body--long { display: none; }
    .hero__body--short { display: block; }
    .hero__eyebrow { margin-bottom: 10px; font-size: 13px; letter-spacing: 0.14em; }
    .hero__eyebrow::before { width: 18px; }
    .hero__title { font-size: clamp(34px, 10.4vw, 52px); }
    .hero__body { margin-top: 12px; font-size: 15px; line-height: 1.45; }
    .hero__cta { margin-top: 16px; gap: 8px; }
    .hero__cta .btn { min-height: 46px; padding-inline: 16px; font-size: 16px; }
    .hero__small { margin-top: 12px; font-size: 11.5px; }
    .hero__small li + li::before { margin: 0 7px; }
    .hero__cue { bottom: 12px; font-size: 13px; }
  }
  @media (max-aspect-ratio: 4/5) and (max-height: 780px) {
    .hero__eyebrow { display: none; }
    .hero__title { font-size: clamp(30px, 9.4vw, 40px); }
    .hero__body { font-size: 14.5px; }
  }
  @media (max-height: 520px) {
    .hero { padding-top: calc(var(--head-h) + 8px); }
    .hero__eyebrow { margin-bottom: 8px; }
    .hero__title { font-size: 34px; }
    .hero__body { margin-top: 10px; font-size: 14.5px; line-height: 1.4; max-width: 62ch; }
    .hero__title, .hero__body { max-width: none; }
    .hero__cta { margin-top: 14px; }
    .hero__cta .btn { min-height: 44px; }
  }
</style>
