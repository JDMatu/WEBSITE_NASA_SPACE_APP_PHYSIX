---
// One frame of the storm sequence: a wide render for landscape screens and a tall one for
// portrait phones, each in AVIF and WebP at several widths.
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  id: string;
  alt: string;
  eager?: boolean;
}
const { id, alt, eager = false } = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/frames/*.{webp,png,jpg}', { eager: true });
const find = (name: string) => Object.entries(files).find(([p]) => p.includes(`/${name}.`))?.[1].default;
const wide = find(`${id}-wide`);
const tall = find(`${id}-tall`);
if (!wide || !tall) throw new Error(`Missing storm frame images for "${id}" in src/assets/frames/`);

const WIDE = [768, 1280, 1920];
const TALL = [480, 720, 900];
const set = async (src: ImageMetadata, widths: number[], format: 'avif' | 'webp') => {
  const out = await Promise.all(widths.map((w) => getImage({ src, width: w, format, quality: format === 'avif' ? 52 : 72 })));
  return out.map((img, i) => `${img.src} ${widths[i]}w`).join(', ');
};
const portrait = '(max-aspect-ratio: 4/5)';
const fallback = await getImage({ src: wide, width: 1280, format: 'webp', quality: 72 });
---

<picture class="frame" data-frame={id}>
  <source media={portrait} type="image/avif" srcset={await set(tall, TALL, 'avif')} sizes="100vw" />
  <source media={portrait} type="image/webp" srcset={await set(tall, TALL, 'webp')} sizes="100vw" />
  <source type="image/avif" srcset={await set(wide, WIDE, 'avif')} sizes="100vw" />
  <source type="image/webp" srcset={await set(wide, WIDE, 'webp')} sizes="100vw" />
  <img
    src={fallback.src}
    width={wide.width}
    height={wide.height}
    alt={alt}
    loading={eager ? 'eager' : 'lazy'}
    decoding={eager ? 'sync' : 'async'}
    fetchpriority={eager ? 'high' : 'low'}
  />
</picture>
