---
import { copy } from '../content';
import SectionHead from './SectionHead.astro';

const L = Astro.currentLocale;
const { credits, ui } = copy(L);
---

<section class="section credits" id="credits" aria-labelledby="credits-title">
  <div class="wrap">
    <SectionHead kicker={credits.kicker} title={credits.title} id="credits-title" />
    <div class="credits__grid">
      {
        credits.groups.map((g) => (
          <div>
            <h3 class="h3">{g.title}</h3>
            <ul>
              {g.items.map((it) => <li>{'href' in it && it.href ? <a href={it.href} rel="noopener">{it.text}</a> : it.text}</li>)}
            </ul>
          </div>
        ))
      }
    </div>
    <p class="credits__note">{credits.musicNote}</p>
  </div>
</section>

<style>
  .credits__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 32px 48px; }
  .credits .h3 { font-size: 16px; color: var(--dim); padding-bottom: 10px; border-bottom: 1px solid var(--hair); }
  .credits ul { margin-top: 10px; display: grid; gap: 8px; font-size: 15px; line-height: 1.5; }
  .credits__note { margin-top: 28px; font-size: 15px; color: var(--dim); }
</style>
